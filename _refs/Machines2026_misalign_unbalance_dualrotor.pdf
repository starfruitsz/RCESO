   <dc:creator>
    <rdf:Seq>
     <rdf:li>Pingping Ma</rdf:li>
     <rdf:li>Muge Liu</rdf:li>
     <rdf:li>Yang Li</rdf:li>
     <rdf:li>Xiantao Zhang and Qingkai Han</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Nonlinear Vibration Responses of a Rigid--Flexible Coupled Dual-Rotor System Under Coexisting Unbalance</rdf:li>
     <rdf:li xml:lang="en-US">Nonlinear Vibration Responses of a Rigid--Flexible Coupled Dual-Rotor System Under Coexisting Unbalance</rdf:li>
     <rdf:li xml:lang="x-default">Misalignment</rdf:li>
     <rdf:li xml:lang="en-US">Misalignment</rdf:li>
     <rdf:li xml:lang="x-default">and Rub-Impact Faults: Numerical Simulation and Experimental Validation</rdf:li>
     <rdf:li xml:lang="en-US">and Rub-Impact Faults: Numerical Simulation and Experimental Validation</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>dual-rotor system; unbalance fault; misalignment fault; rub-impact fault; multi-fault coupling; nonlinear vibration; experimental validation</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:type>
    <rdf:Bag>
     <rdf:li>Text</rdf:li>
    </rdf:Bag>
   </dc:type>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Aero-engine dual-rotor systems commonly suffer from simultaneous unbalance</rdf:li>
     <rdf:li xml:lang="en-US">Aero-engine dual-rotor systems commonly suffer from simultaneous unbalance</rdf:li>
     <rdf:li xml:lang="x-default">support misalignment</rdf:li>
     <rdf:li xml:lang="en-US">support misalignment</rdf:li>
     <rdf:li xml:lang="x-default">and rotor--stator rub-impact</rdf:li>
     <rdf:li xml:lang="en-US">and rotor--stator rub-impact</rdf:li>
     <rdf:li xml:lang="x-default">triggering complex coupled nonlinear vibrations</rdf:li>
     <rdf:li xml:lang="en-US">triggering complex coupled nonlinear vibrations</rdf:li>
     <rdf:li xml:lang="x-default">aliased fault features and dynamic instability. Most prior research concentrates on single-fault cases using linear superposition</rdf:li>
     <rdf:li xml:lang="en-US">aliased fault features and dynamic instability. Most prior research concentrates on single-fault cases using linear superposition</rdf:li>
     <rdf:li xml:lang="x-default">neglecting nonlinear interactions among multiple faults. This study constructs a rigid--flexible coupled dual-rotor dynamic model incorporating inter-shaft bearing effects</rdf:li>
     <rdf:li xml:lang="en-US">neglecting nonlinear interactions among multiple faults. This study constructs a rigid--flexible coupled dual-rotor dynamic model incorporating inter-shaft bearing effects</rdf:li>
     <rdf:li xml:lang="x-default">rub-impact constraints</rdf:li>
     <rdf:li xml:lang="en-US">rub-impact constraints</rdf:li>
     <rdf:li xml:lang="x-default">and misalignment-induced torque. Numerical simulations and parameter analyses are conducted to explore vibration behaviors under single and coupled faults. Results show unbalance and misalignment dominate low-speed vibration and suppress rub-impact</rdf:li>
     <rdf:li xml:lang="en-US">and misalignment-induced torque. Numerical simulations and parameter analyses are conducted to explore vibration behaviors under single and coupled faults. Results show unbalance and misalignment dominate low-speed vibration and suppress rub-impact</rdf:li>
     <rdf:li xml:lang="x-default">while rub-impact effects are enhanced at medium--high speeds. Misalignment worsens rubbing and unbalance magnifies resonance</rdf:li>
     <rdf:li xml:lang="en-US">while rub-impact effects are enhanced at medium--high speeds. Misalignment worsens rubbing and unbalance magnifies resonance</rdf:li>
     <rdf:li xml:lang="x-default">exhibiting multi-fault amplification. Triple-fault coupling produces noise bands</rdf:li>
     <rdf:li xml:lang="en-US">exhibiting multi-fault amplification. Triple-fault coupling produces noise bands</rdf:li>
     <rdf:li xml:lang="x-default">distorted orbits</rdf:li>
     <rdf:li xml:lang="en-US">distorted orbits</rdf:li>
     <rdf:li xml:lang="x-default">and periodic--chaotic alternation. Dual-rotor test-rig experiments validate the simulation findings: unbalance excites fundamental components</rdf:li>
     <rdf:li xml:lang="en-US">and periodic--chaotic alternation. Dual-rotor test-rig experiments validate the simulation findings: unbalance excites fundamental components</rdf:li>
     <rdf:li xml:lang="x-default">misalignment amplifies 2N1 harmonics</rdf:li>
     <rdf:li xml:lang="en-US">misalignment amplifies 2N1 harmonics</rdf:li>
     <rdf:li xml:lang="x-default">rub-impact generates combined frequencies</rdf:li>
     <rdf:li xml:lang="en-US">rub-impact generates combined frequencies</rdf:li>
     <rdf:li xml:lang="x-default">and coupled faults cause feature aliasing and amplitude modulation. This work reveals multi-fault vibration mutation mechanisms and supports fault decoupling</rdf:li>
     <rdf:li xml:lang="en-US">and coupled faults cause feature aliasing and amplitude modulation. This work reveals multi-fault vibration mutation mechanisms and supports fault decoupling</rdf:li>
     <rdf:li xml:lang="x-default">diagnosis</rdf:li>
     <rdf:li xml:lang="en-US">diagnosis</rdf:li>
     <rdf:li xml:lang="x-default">and vibration control for aero-engine dual-rotor systems.</rdf:li>
     <rdf:li xml:lang="en-US">and vibration control for aero-engine dual-rotor systems.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:language>
    <rdf:Bag>
     <rdf:li>en-US</rdf:li>
    </rdf:Bag>
   </dc:language>
